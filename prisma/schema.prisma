// Venom Arena — server-authoritative multiplayer snake game
// SQLite backing store. Arrays are encoded as JSON strings (SQLite limitation).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Player {
  id              String   @id @default(cuid())
  email           String?  @unique // null for guest accounts
  emailVerified   Boolean  @default(false)
  passwordHash    String?  // null for guests
  securityPin     String?  // optional 4-digit PIN for password recovery
  userTag         String   @unique // e.g. VENOM-8291
  name            String
  country         String   @default("US")
  region          String   @default("EU")  // auto-computed from country on signup
  avatar          String?

  // OAuth — for social login (Google, Facebook, Apple)
  oauthProvider   String?  // "google" | "facebook" | "apple" | null
  oauthProviderId String?  // unique ID from the OAuth provider

  // Economy
  bankedChips     Int      @default(150)
  totalEarned     Int      @default(150)
  totalLost       Int      @default(0)

  // Progression
  level           Int      @default(1)
  xp              Int      @default(0)
  lifetimeKills   Int      @default(0)
  lifetimeDeaths  Int      @default(0)
  lifetimeExtracts Int     @default(0)
  bestStreak      Int      @default(0)
  biggestExtract  Int      @default(0)

  // Daily rewards
  dailyStreak     Int      @default(0)
  lastDailyClaim  String?  // ISO date (YYYY-MM-DD)
  lastHourlyClaim DateTime? // last hourly claim timestamp
  streakFreezes   Int      @default(0) // purchasable streak protection
  referralCode    String?  @unique // e.g. "VIPER-A7X2"

  // Season Pass — Genesis Season
  hasElitePass     Boolean  @default(false)
  passClaimedFree  String   @default("[]")   // JSON array of claimed tier numbers
  passClaimedElite String   @default("[]")   // JSON array of claimed elite tier numbers
  passXp           Int      @default(0)      // total pass XP (independent of player XP)
  passXpToday      Int      @default(0)      // pass XP earned today (for daily cap)
  passXpDate       String?                  // ISO date of last passXpToday reset (YYYY-MM-DD)

  // Cosmetics — JSON-encoded arrays/objects (default set in code on register)
  unlockedSkins   String   @default("[]")
  currentSkin     String   @default("skin-viper-green")
  currentTrail    String   @default("trail-none")
  currentDeath    String   @default("death-default")
  currentFlag     String?
  currentBanner   String?
  customSkins     String   @default("[]") // JSON array of named custom skin configs (max 5)

  // Admin / moderation
  role            String   @default("player") // player | admin
  banned          Boolean  @default(false)
  tokenVersion    Int      @default(0) // incremented on password change to invalidate sessions

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  lastSeenAt      DateTime @default(now())

  clanTag         String?
  clan            Clan?    @relation(fields: [clanTag], references: [tag], onDelete: SetNull)
  clanRank        String?  // Leader | Co-Leader | Viper
  clanDeposited   Int      @default(0)  // tracks how much this player has deposited into their current clan

  // Identity change cooldowns (leaderboard integrity — prevents name/country abuse)
  nameChangedAt     DateTime?
  countryChangedAt  DateTime?

  // Social links (creator channels)
  instagram       String?
  youtube         String?
  twitch          String?
  instagramVerified  Boolean  @default(false)
  youtubeVerified    Boolean  @default(false)
  twitchVerified     Boolean  @default(false)

  // Crafting & Inventory
  skinPieces           SkinPiece[]
  craftingTransactions CraftingTransaction[]

  // Relations
  dailyClaims     DailyClaim[]
  hourlyClaims    HourlyClaim[]
  matchHistory    MatchHistory[]
  streakMilestones StreakMilestoneClaim[]
  luckySpins      LuckySpin[]
  promoRewards    PromoReward[]
  videoRewards    VideoReward[]
  referralsSent   Referral[]    @relation("referralSender")
  referralsReceived Referral[]  @relation("referralReceiver")
  purchases       Purchase[]
  storeOrders     StoreOrder[]
  sentGifts       Gift[]     @relation("giftFrom")
  receivedGifts   Gift[]     @relation("giftTo")
  friendsFrom     Friendship[] @relation("friendshipInitiator")
  friendsTo       Friendship[] @relation("friendshipRecipient")
  challenges      Challenge[]
  milestones      PlayerMilestone[]
  championshipRegs ChampionshipRegistration[]
  hofEntries     HallOfFameEntry[]
  clips           Clip[]
  clipUpvotes     ClipUpvote[]
  following       Follow[]    @relation("following")
  followers       Follow[]    @relation("follower")
  rivals          Rival[]     @relation("rivalOwner")

  @@index([bankedChips(sort: Desc)])
  @@index([level(sort: Desc)])
  @@index([role])
}

model Clan {
  tag             String   @id // e.g. "APEX" (3-5 chars)
  name            String
  emblem          String   @default("🐍")
  description     String   @default("")
  level           Int      @default(1)
  xp              Int      @default(0)
  totalDeposited  Int      @default(0)
  bankedChips     Int      @default(0)
  maxMembers      Int      @default(30)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  members         Player[]
  messages        ClanMessage[]
  activities      ClanActivity[]
  challenges      ClanChallenge[]
  purchases       ClanPurchase[]
  warsDeclared    ClanWar[] @relation("warDeclaringClan")
  warsReceived    ClanWar[] @relation("warTargetClan")
}

model ClanActivity {
  id        String   @id @default(cuid())
  clanTag   String
  clan      Clan     @relation(fields: [clanTag], references: [tag], onDelete: Cascade)
  type      String   // "join" | "leave" | "deposit" | "create" | "promote" | "demote" | "challenge_claim" | "level_up"
  actorTag  String
  actorName String
  detail    String?  // e.g. "deposited 500c" or "promoted USER to Co-Leader"
  createdAt DateTime @default(now())

  @@index([clanTag, createdAt(sort: Desc)])
}

model ClanChallenge {
  id          String   @id @default(cuid())
  clanTag     String
  clan        Clan     @relation(fields: [clanTag], references: [tag], onDelete: Cascade)
  type        String   // "treasury_target" | "recruitment_drive" | "chat_activity" | "deposit_streak"
  title       String
  description String
  target      Int
  progress    Int      @default(0)
  reward      Int      // chips reward to treasury on claim
  claimed     Boolean  @default(false)
  claimedBy   String?
  weekStart   String   // ISO date of challenge week start (YYYY-MM-DD)
  createdAt   DateTime @default(now())

  @@unique([clanTag, type, weekStart])
  @@index([clanTag, weekStart])
}

model ClanMessage {
  id        String   @id @default(cuid())
  clanTag   String
  clan      Clan     @relation(fields: [clanTag], references: [tag], onDelete: Cascade)
  senderTag String
  senderName String
  rank      String   @default("Viper")
  message   String
  createdAt DateTime @default(now())

  @@index([clanTag, createdAt])
}

model DailyClaim {
  id        String   @id @default(cuid())
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  playerId  String
  day       String   // YYYY-MM-DD
  reward    Int
  streak    Int
  createdAt DateTime @default(now())

  @@unique([playerId, day])
}

model HourlyClaim {
  id        String   @id @default(cuid())
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  playerId  String
  reward    Int
  createdAt DateTime @default(now())

  @@index([playerId, createdAt])
}

model StreakMilestoneClaim {
  id        String   @id @default(cuid())
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  playerId  String
  milestone Int      // 30, 60, 90
  reward    Int
  createdAt DateTime @default(now())

  @@unique([playerId, milestone])
}

model LuckySpin {
  id        String   @id @default(cuid())
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  playerId  String
  reward    Int
  prizeTier String   // "common" | "rare" | "epic" | "legendary"
  createdAt DateTime @default(now())

  @@index([playerId, createdAt])
}

model PromoReward {
  id        String   @id @default(cuid())
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  playerId  String
  code      String
  reward    Int
  createdAt DateTime @default(now())

  @@index([playerId])
  @@unique([playerId, code])
}

model VideoReward {
  id        String   @id @default(cuid())
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  playerId  String
  reward    Int
  createdAt DateTime @default(now())

  @@index([playerId, createdAt])
}

model Referral {
  id            String   @id @default(cuid())
  referrer      Player   @relation("referralSender", fields: [referrerId], references: [id], onDelete: Cascade)
  referrerId    String
  referred      Player   @relation("referralReceiver", fields: [referredId], references: [id], onDelete: Cascade)
  referredId    String
  status        String   @default("pending") // pending | active | claimed
  matchesPlayed Int      @default(0)
  reward        Int      @default(0)
  createdAt     DateTime @default(now())

  @@unique([referredId])
  @@index([referrerId])
}

model Purchase {
  id         String   @id @default(cuid())
  player     Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  playerId   String
  itemId     String   // skin id or chip pack id
  itemType   String   // "skin" | "chip_pack"
  amountChips Int     // chips spent (skins) or gained (chip packs)
  createdAt  DateTime @default(now())

  @@index([playerId, createdAt])
}

model Gift {
  id         String   @id @default(cuid())
  from       Player   @relation("giftFrom", fields: [fromId], references: [id], onDelete: Cascade)
  fromId     String
  to         Player   @relation("giftTo", fields: [toId], references: [id], onDelete: Cascade)
  toId       String
  amount     Int
  createdAt  DateTime @default(now())

  @@index([fromId, createdAt])
  @@index([toId, createdAt])
}

// Real-money chip purchases via Google Play Billing / Apple StoreKit 2 (IAP).
// One row per store transaction; storeTxId is the idempotency key so a replayed
// receipt can never double-credit. Price/chips snapshot comes from the
// server-side catalog (src/lib/store-catalog.ts), never from the client.
model StoreOrder {
  id           String   @id @default(cuid())
  player       Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  playerId     String
  platform     String   // "android" | "ios"
  packId       String   // internal pack id, e.g. "pack-100"
  productId    String   // store product id, e.g. "venom.chips.100"
  storeTxId    String   @unique // Google purchaseToken / Apple transactionId
  chips        Int      // chips credited (catalog snapshot)
  pricePaidINR Int?     // catalog reference price at purchase time
  status       String   @default("completed") // completed | refunded
  verifierNote String?  // short verification summary (JSON string)
  createdAt    DateTime @default(now())

  @@index([playerId, createdAt])
  @@index([status, createdAt])
}

model Friendship {
  id           String   @id @default(cuid())
  initiator    Player   @relation("friendshipInitiator", fields: [initiatorId], references: [id], onDelete: Cascade)
  initiatorId  String
  recipient    Player   @relation("friendshipRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  recipientId  String
  status       String   @default("pending") // pending | accepted | blocked
  createdAt    DateTime @default(now())

  @@unique([initiatorId, recipientId])
  @@index([recipientId, status])
}

model Challenge {
  id          String   @id @default(cuid())
  playerId    String
  player      Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  type        String   // "daily" | "weekly"
  category    String   // "kill" | "extract" | "star_collect" | "score" | "arena_entry"
  title       String
  description String
  target      Int      // target value to complete
  current     Int      @default(0) // progress so far
  reward      Int      // chips reward
  completed   Boolean  @default(false)
  claimed     Boolean  @default(false)
  periodStart String   // ISO date when this challenge period started (YYYY-MM-DD)
  createdAt   DateTime @default(now())

  @@index([playerId, type])
  @@index([playerId, periodStart])
}

model ChallengeProgress {
  id          String   @id @default(cuid())
  playerId    String
  category    String   // "kill" | "extract" | "star_collect" | "score" | "arena_entry"
  periodType  String   // "daily" | "weekly"
  periodStart String   // ISO date
  increment   Int      @default(1) // how much to add per event
  createdAt   DateTime @default(now())

  @@unique([playerId, category, periodType, periodStart])
}

// Player milestone tracking — records when a player first reaches each chip tier
model PlayerMilestone {
  id              String   @id @default(cuid())
  playerId        String
  player          Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  tierId          String   // bronze | silver | gold | platinum | diamond | omega
  chipsAtMilestone Int     // banked chips when milestone was recorded
  createdAt       DateTime @default(now())

  @@unique([playerId, tierId])
  @@index([playerId])
  @@index([tierId, createdAt])
}

model GameConfig {
  id        String   @id @default(cuid())
  key       String   @unique // e.g. "snake.collisionRadius"
  value     String   // JSON-encoded value (number, string, boolean, or object)
  label     String   // human-readable name for admin panel
  category  String   // "snake_physics" | "food_system" | "map_settings" | "boost_system" | "collision" | "economy" | "bot_settings" | "extraction" | "spawning"
  order     Int      @default(0) // display order within category
  type      String   @default("number") // "number" | "boolean" | "string" | "json"
  updatedAt DateTime @updatedAt
}

// Championship — annual tournament tracking per player
model ChampionshipRegistration {
  id            String    @id @default(cuid())
  playerId      String
  player        Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)
  year          Int                              // e.g. 2026
  gamesPlayed   Int       @default(0)
  isActive      Boolean   @default(true)
  registeredAt  DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([playerId, year])
  @@index([year, isActive])
  @@index([playerId, year])
}

// Championship archive — historical championship data for past years
model ChampionshipArchive {
  id                String    @id @default(cuid())
  year              Int       @unique                 // e.g. 2025
  title             String                            // "2025 Annual Venom World Championship"
  status            String    @default("completed")   // completed | active
  winnerTag         String?                           // userTag of the global winner
  winnerName        String?
  winnerCountry     String?
  winnerClanTag     String?
  winnerChips       Int?
  totalParticipants Int       @default(0)
  topClanTag        String?                           // clan with most top-100 members
  topClanName       String?
  payoutsProcessed  Boolean   @default(false)
  createdAt         DateTime  @default(now())
  finalizedAt       DateTime?

  @@index([year])
}

// Match History — records every game result for the player profile
model MatchHistory {
  id              String   @id @default(cuid())
  player          Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  playerId        String
  arenaId         String   // tier-1, tier-2, etc.
  arenaName       String   // e.g. "Slum Alley"
  isOnline        Boolean  @default(false)
  status          String   // "EXTRACTED" | "COLLIDED"
  chipsEarned     Int      @default(0)
  chipsLost       Int      @default(0)
  kills           Int      @default(0)
  snakeLength     Int      @default(0)
  durationSec     Int      @default(0)
  createdAt       DateTime @default(now())

  @@index([playerId, createdAt(sort: Desc)])
}

// Hall of Fame — permanent record of milestone achievements & championship inductees
model HallOfFameEntry {
  id               String   @id @default(cuid())
  playerId         String
  player           Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  inductionType    String   // "milestone" | "championship"
  milestoneTierId  String?  // "t-1lakh", "t-5lakh", "t-10lakh", "t-25lakh", "t-50lakh", "t-1crore"
  championshipYear Int?
  championshipRank Int?
  hofBadge         String?  // "crown" | "silver" | "bronze" | "contender" (championship) or milestone badge name
  title            String?  // e.g. "2026 WORLD VENOM CHAMPION" or "🥉 Bronze Elite"
  chipsAtInduction Int      @default(0)
  inductedAt       DateTime @default(now())

  @@unique([playerId, inductionType, milestoneTierId, championshipYear])
  @@index([inductionType])
  @@index([championshipYear])
  @@index([milestoneTierId, inductedAt])
  @@index([playerId])
}

model Clip {
  id             String   @id @default(cuid())
  player         Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  playerId       String
  matchId        String?
  title          String
  description    String   @default("")
  platform       String   @default("other")    // "YouTube" | "Twitch" | "Instagram" | "match-card"
  url            String                          // external URL or empty string for match-cards
  thumbnailUrl   String?
  chipsExtracted Int      @default(0)
  kills          Int      @default(0)
  arenaName      String   @default("")
  tags           String   @default("[]")
  upvotes        Int      @default(0)
  downvotes      Int      @default(0)
  featured       Boolean  @default(false)
  cardType       String   @default("user-clip")  // "user-clip" | "match-card"
  matchData      String?                           // JSON: { outcome, chipsLost, snakeLength, durationSec, isOnline }
  status         String   @default("pending")      // "pending" | "approved" | "rejected" — user clips need admin approval
  reviewedBy     String?                           // admin playerId who reviewed
  reviewedAt     DateTime?
  createdAt      DateTime @default(now())

  @@index([playerId, createdAt(sort: Desc)])
  @@index([featured, createdAt(sort: Desc)])
  @@index([upvotes(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@index([cardType, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
}

model ClipUpvote {
  id       String @id @default(cuid())
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  playerId String
  clipId   String
  voteType String @default("like") // "like" | "dislike"
  createdAt DateTime @default(now())

  @@unique([playerId, clipId])
}

model Follow {
  id          String   @id @default(cuid())
  follower    Player   @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  followerId  String
  following   Player   @relation("following", fields: [followingId], references: [id], onDelete: Cascade)
  followingId String
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followingId])
  @@index([followerId])
}

model Rival {
  id             String    @id @default(cuid())
  player         Player    @relation("rivalOwner", fields: [playerId], references: [id], onDelete: Cascade)
  playerId       String
  rivalTag       String
  rivalName      String    @default("")
  timesKilledBy  Int       @default(0)
  timesKilledYou Int       @default(0)
  lastEncounterAt DateTime?
  createdAt      DateTime   @default(now())

  @@unique([playerId, rivalTag])
  @@index([playerId])
}

model ClanPurchase {
  id        String   @id @default(cuid())
  clanTag   String
  clan      Clan     @relation(fields: [clanTag], references: [tag], onDelete: Cascade)
  itemId    String   // "member_expansion" | "xp_windfall" | "clan_rename" | "war_shield"
  cost      Int      // chips spent from treasury
  purchasedBy String   // userTag of the leader who purchased
  createdAt DateTime @default(now())

  @@index([clanTag, createdAt(sort: Desc)])
}

model ClanWar {
  id            String   @id @default(cuid())
  declarerTag   String
  declarer      Clan     @relation("warDeclaringClan", fields: [declarerTag], references: [tag], onDelete: Cascade)
  targetTag     String
  target        Clan     @relation("warTargetClan", fields: [targetTag], references: [tag], onDelete: Cascade)
  wager        Int      // chips wagered by EACH clan (total pot = wager * 2)
  declarerScore Int      @default(0) // total kills by declarer clan members during war
  targetScore  Int      @default(0) // total kills by target clan members during war
  status        String   @default("active") // "active" | "ended"
  winnerTag    String?  // set when war ends
  startedAt     DateTime @default(now())
  endedAt      DateTime?

  @@index([declarerTag, status])
  @@index([targetTag, status])
}

// Skin pieces collected from level chests
// Run: bun run db:push
model SkinPiece {
  id          String   @id @default(cuid())
  playerId    String
  skinSetId  String
  pieceIndex  Int      // 0-based index within the set
  totalPieces Int      // total pieces in this set (e.g., 30)
  rarity     String   // 'common' | 'rare' | 'epic' | 'legendary'
  source      String   // 'level_chest' | 'challenge_reward' | 'trade' | 'event'
  obtainedAt  Int      @default(0)

  player      Player   @relation(fields: [playerId], references: [id])
  set         CollectionSet @relation(fields: [skinSetId], references: [id])

  @@unique([playerId, skinSetId, pieceIndex])
}

// Collection sets that can be completed and sacrificed for skins
// Run: bun run db:push
model CollectionSet {
  id             String   @id @default(cuid())
  name           String
  description    String?
  rewardSkinId  String   // the skin you get from completing
  rewardRarity   String   // 'common' | 'rare' | 'epic' | 'legendary'
  totalPieces    Int      @default(30)
  requiredLevel  Int      @default(1)
  piecesPerChest Int      @default(2)
  icon           String   @default("")
  color          String   @default("")

  pieces         SkinPiece[]
}

// Crafting transactions (sacrifice history)
// Run: bun run db:push
model CraftingTransaction {
  id               String   @id @default(cuid())
  playerId         String
  sacrificedSetId  String
  resultSkinId     String
  resultRarity    String
  resultSkinName   String
  timestamp        Int      @default(0)

  player           Player   @relation(fields: [playerId], references: [id])
}

model VerificationToken {
  id        String   @id @default(cuid())
  token     String   @unique
  email     String
  playerId  String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@index([token])
}

// X11: append-only admin action audit trail. Deliberately has NO relation to
// Player — admin accounts can be deleted/anonymized and the log must survive.
model AdminAuditLog {
  id         String   @id @default(cuid())
  adminId    String   // Player.id of the acting admin
  adminTag   String   // denormalized VM-XXXXXX tag for quick display
  action     String   // e.g. 'ban', 'modify_chips', 'clan_disband', 'config_update'
  targetType String?  // 'player' | 'clan' | 'config' | 'clip' | 'hof'
  targetId   String?  // userTag / clan tag / config key / clip id
  details    String?  // JSON string with action-specific payload summary
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([adminId])
  @@index([action])
}
