# Release signing — copy this file to android/keystore.properties and fill in
# real values after generating your keystore (see RELEASE-CHECKLIST.md, step A3).
# android/keystore.properties is gitignored — never commit the real one.
#
# storeFile=/absolute/path/on/your/machine/venom-arena-release.jks
# storePassword=YOUR_KEYSTORE_PASSWORD
# keyAlias=venom-arena
# keyPassword=YOUR_KEY_PASSWORD
