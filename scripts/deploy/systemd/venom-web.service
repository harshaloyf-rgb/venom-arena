[Unit]
Description=Venom Arena web (Next.js standalone)
After=network.target

[Service]
# Deploy layout (see scripts/deploy/deploy.sh):
#   /opt/venom-arena/web/                 <- standalone bundle + .env
# ExecStart path is rewritten to the remote `which bun` by deploy.sh.
WorkingDirectory=/opt/venom-arena/web
EnvironmentFile=/opt/venom-arena/web/.env
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOSTNAME=127.0.0.1
ExecStart=/usr/bin/bun server.js
Restart=always
RestartSec=3
# Hardening: prod server only needs its working dir + net
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
